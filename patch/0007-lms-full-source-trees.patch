 packages/libxml2.cmake          | 2 +-
 packages/nghttp3.cmake          | 2 +-
 packages/ngtcp2.cmake           | 2 +-
 packages/openssl.cmake          | 2 +-
 16 files changed, 16 insertions(+), 16 deletions(-)

diff --git a/packages/avisynth-headers.cmake b/packages/avisynth-headers.cmake
index eee0180..23f8617 100644
--- a/packages/avisynth-headers.cmake
+++ b/packages/avisynth-headers.cmake
@@ -2,7 +2,7 @@ ExternalProject_Add(avisynth-headers
     GIT_REPOSITORY https://github.com/AviSynth/AviSynthPlus.git
     SOURCE_DIR ${SOURCE_LOCATION}
     GIT_CLONE_FLAGS "--sparse --filter=tree:0"
-    GIT_CLONE_POST_COMMAND "sparse-checkout set --no-cone /* !distrib"
+    GIT_CLONE_POST_COMMAND "sparse-checkout disable"
     GIT_SUBMODULES ""
     UPDATE_COMMAND ""
     GIT_RESET 21fdc997f9724b994896ba5520ddf64d677976b3

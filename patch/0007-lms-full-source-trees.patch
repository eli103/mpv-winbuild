From 74906baed1d73c51ea860983fc20837ea766611f Mon Sep 17 00:00:00 2001
From: Eric Li <lizhi.xmu@gmail.com>
Date: Thu, 17 Sep 2026 05:25:53 +0800
Subject: [PATCH] deps: keep each recipe's clone depth and fetch GIT_RESET
 commits

Round 4 dropped --filter=tree:0 but also forced --depth=1 everywhere. For recipes that
pin a commit with GIT_RESET and patch with `git am --3way` (openssl, vapoursynth, ...)
that removed the objects: the forced update's `git reset --hard <sha>` failed, openssl
stayed on master and was configured without QUIC, and ngtcp2 then failed with
'Unable to build OpenSSL backend due to lack of QUIC support'.

Now only --sparse/--filter=tree:0 are dropped (each recipe keeps its own depth), and
force-update additionally fetches the GIT_RESET commit before reset_head.sh runs.
---
 cmake/custom_steps.cmake        | 4 ++++
 packages/avisynth-headers.cmake | 3 +--
 packages/brotli.cmake           | 3 +--
 packages/curl.cmake             | 3 +--
 packages/expat.cmake            | 3 +--
 packages/ffmpeg.cmake           | 3 +--
 packages/fribidi.cmake          | 3 +--
 packages/glslang.cmake          | 3 +--
 packages/harfbuzz.cmake         | 3 +--
 packages/libmysofa.cmake        | 3 +--
 packages/libpsl.cmake           | 3 +--
 packages/libsdl2.cmake          | 3 +--
 packages/libsixel.cmake         | 3 +--
 packages/libxml2.cmake          | 3 +--
 packages/nghttp3.cmake          | 3 +--
 packages/ngtcp2.cmake           | 3 +--
 packages/openssl.cmake          | 3 +--
 17 files changed, 20 insertions(+), 32 deletions(-)

diff --git a/cmake/custom_steps.cmake b/cmake/custom_steps.cmake
index a3e82cd..19838bf 100644
--- a/cmake/custom_steps.cmake
+++ b/cmake/custom_steps.cmake
@@ -115,6 +115,10 @@ PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_
         WORKING_DIRECTORY <SOURCE_DIR>
         COMMAND bash -c "git am --abort 2> /dev/null || true"
         COMMAND bash -c "git fetch --filter=tree:0 --no-recurse-submodules || true"
+        # lms: the fetch above only gets the branch, so a GIT_RESET commit is missing
+        # on a fresh/shallow clone and reset_head.sh would fail (e.g. openssl, which
+        # then builds without QUIC and breaks ngtcp2). Fetch the pinned commit directly.
+        COMMAND bash -c "test -z \"${git_reset}\" || git fetch --depth=1 --no-tags --no-recurse-submodules origin ${git_reset} || true"
         COMMAND ${stamp_dir}/reset_head.sh
     )
     ExternalProject_Add_StepTargets(${_name} force-update)
